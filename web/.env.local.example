# Copier vers .env.local et compléter.
# Toute variable NEXT_PUBLIC_* est exposée au navigateur : n'y mettre aucun secret.

# ── Site ─────────────────────────────────────────────────────────────────────
# URL canonique, utilisée par les métadonnées, le sitemap et l'Open Graph.
# En l'absence de cette variable, VERCEL_PROJECT_PRODUCTION_URL prend le relais
# sur Vercel, puis http://localhost:3000 en développement.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Style de tuiles vectorielles MapLibre. Par défaut le style « positron »
# d'OpenFreeMap, gratuit et sans inscription. L'origine de cette URL est
# reprise automatiquement dans la Content-Security-Policy.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron

# ── Base de données (serveur uniquement) ─────────────────────────────────────
# Chaîne de connexion Neon. Utilisée par npm run db:* , les scripts
# d'ingestion et la route /api/push/register.
# Copier la « Pooled connection » depuis la console Neon.
CONNECTION_STRING=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Formulaire de signalement (serveur uniquement) ───────────────────────────
# Sans ces trois variables, /api/signaler journalise le signalement au lieu de
# l'envoyer par courriel.
RESEND_API_KEY=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=

# ── Ingestion (serveur uniquement) ───────────────────────────────────────────
# Flux DATAtourisme au format ZIP. Sans cette variable, la source est ignorée.
DATATOURISME_FLUX_URL=

# ── Affiliation billetterie ──────────────────────────────────────────────────
# Identifiants ajoutés en paramètre « aff » sur les liens sortants.
# Publics par nature : ils apparaissent dans l'URL cliquée.
NEXT_PUBLIC_SHOTGUN_AFFILIATE=
NEXT_PUBLIC_RA_AFFILIATE=
NEXT_PUBLIC_DICE_AFFILIATE=

{
  "expo": {
    "name": "BPMap",
    "slug": "bpmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bpmap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bpmap.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.bpmap.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 160
          }
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {},
          "ios": {
            "metalEnabled": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BPMap utilise ta position pour calculer l'itinéraire vers un festival."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "apiUrl": "https://bpmap.vercel.app",
      "eas": {
        "projectId": "90adb929-880b-43d7-a79c-fc6e4b1a045e"
      }
    },
    "owner": "mco994"
  }
}
